# Random seed for train_mlm.py and probe.py
SEED=3345678

# MLM corpus for train_mlm.py: parquet, one document per row in a 'text' column, optional label columns
MLM_TRAIN_FILE=/path/to/mlm_train.parquet
MLM_EVAL_FILE=/path/to/mlm_eval.parquet

# Probe sets for probe.py: parquet with a 'text' column plus label columns
PROBE_TRAIN_FILE=/path/to/probe_train.parquet
PROBE_EVAL_FILE=/path/to/probe_eval.parquet